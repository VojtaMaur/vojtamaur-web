---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const archive = readFileSync(
  resolve(process.cwd(), 'public', 'ARCHIVE.txt'),
  'utf-8'
);

const match = archive.match(
  /=== ENTRY POINTS START ===([\s\S]*?)=== ENTRY POINTS END ===/
);

const entryPoints = (
  match
    ? match[1].trim()
    : 'Entry points not found.'
).replaceAll('\t', '  ');

const parts = entryPoints.split(
  /((?:https?|gemini|gopher):\/\/[^\s<>"']+)/gi
);

const isUrl = (value: string) =>
  /^(?:https?|gemini|gopher):\/\/[^\s<>"']+$/.test(value);

const isHttpUrl = (value: string) =>
  /^https?:\/\//i.test(value);
---

<pre class="entry-points">{parts.map((part) =>
  isUrl(part)
    ? (
      <a
        href={part}
        rel={isHttpUrl(part) ? 'noopener noreferrer' : undefined}
      >{part}</a>
    )
    : part
)}</pre>
