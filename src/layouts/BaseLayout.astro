---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { localizePath, type Lang } from "../lib/i18n";

const {
  title = "Vojta Maur",
  description = "Osobní web Vojty Maura",
  lang = "cs",
  canonicalPath,
  alternateCsPath,
  alternateEnPath,
  noindex = false,
} = Astro.props as {
  title?: string;
  description?: string;
  lang?: Lang;
  canonicalPath?: string;
  alternateCsPath?: string;
  alternateEnPath?: string;
  noindex?: boolean;
};

const pathname = Astro.url.pathname;
const pathForCs = alternateCsPath ?? localizePath(pathname, "cs");
const pathForEn = alternateEnPath;
const currentPath = canonicalPath ?? (lang === "en" ? (pathForEn ?? localizePath(pathname, "en")) : pathForCs);

const canonicalUrl = new URL(currentPath, Astro.site);
const csUrl = new URL(pathForCs, Astro.site);
const enUrl = pathForEn ? new URL(pathForEn, Astro.site) : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"}
    />

    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="cs" href={csUrl.href} />
    {enUrl && <link rel="alternate" hreflang="en-US" href={enUrl.href} />}
    <link rel="alternate" hreflang="x-default" href={csUrl.href} />

    <!-- Favicon systém -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />

    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content="#000000" />

    <style is:inline>
      html[lang="cs"] [data-lang-only]:not([data-lang-only="cs"]),
      html[lang="en"] [data-lang-only]:not([data-lang-only="en"]) {
        display: none !important;
      }
    </style>
  </head>

  <body>
    <Header lang={lang} pathForCs={pathForCs} pathForEn={pathForEn} />
    <div class="site-shell">
      <slot />
    </div>
  </body>
</html>
