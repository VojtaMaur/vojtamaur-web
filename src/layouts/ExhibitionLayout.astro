---
import BaseLayout from "./BaseLayout.astro";
import type { Lang } from "../lib/i18n";

const { frontmatter, lang = "cs" } = Astro.props as { frontmatter: any; lang?: Lang };

const {
  title,
  description,
  dateFrom,
  dateTo,
  city,
  venue,
  exhibition
} = frontmatter;
---

<BaseLayout title={title} description={description} lang={lang}>
  <main class="post-page" data-i18n="translate">
    <h1 class="post-title">{title}</h1>

    <p class="post-meta">
      {dateFrom}{dateTo ? ` - ${dateTo}` : ""}{city ? `, ${city}` : ""}
    </p>

    <p class="post-meta">
      {venue}{venue && exhibition ? ": " : ""}{exhibition}
    </p>

    <slot />
  </main>
</BaseLayout>
