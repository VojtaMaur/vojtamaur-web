---
import { getCollection, render, type CollectionEntry } from "astro:content";
import RosettaPage from "../components/RosettaPage.astro";
import { getRosettaLanguages, type RosettaLanguage } from "../lib/rosetta";

interface Props {
  post?: CollectionEntry<"posts">;
  rosetta?: RosettaLanguage;
}
import PostLayout from "../layouts/PostLayout.astro";
import { canonicalPostPath, formatMonthYear } from "../lib/i18n";

const lang = "cs" as const;

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  const languages = await getRosettaLanguages();
  for (const language of languages) {
    if (posts.some((post) => post.data.slug === language.code)) {
      throw new Error(`Rosetta language conflicts with an article slug: ${language.code}`);
    }
  }
  return [
    ...posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } })),
    ...languages.map((rosetta) => ({ params: { slug: rosetta.code }, props: { rosetta } })),
  ];
}

const { post, rosetta } = Astro.props;
const rendered = post ? await render(post) : undefined;
const Content = rendered?.Content;
const d = post?.data;
const csPath = d ? canonicalPostPath(d.slug, "cs") : undefined;
const enPath = d ? canonicalPostPath(d.slug, "en") : undefined;
---

{rosetta && <RosettaPage language={rosetta} />}
{d && Content && (
<PostLayout
  title={`${d.title} | Vojta Maur`}
  description={d.excerpt ?? d.title}
  lang={lang}
  canonicalPath={csPath}
  alternateCsPath={csPath}
  alternateEnPath={enPath}
>
  <article>
    <div class="post-header">
      {d.section === "vystavy" ? (
        <>
          <h1 class="post-title">{d.title}</h1>

          <p class="post-meta">
            {d.dateFrom}{d.dateTo ? ` - ${d.dateTo}` : ""}{d.city ? `, ${d.city}` : ""}
          </p>

          {(d.venue || d.exhibition) && (
            <p class="post-meta">
              {d.venue}{d.venue && d.exhibition ? ": " : ""}{d.exhibition}
            </p>
          )}
        </>
      ) : d.section === "cestovani" ? (
        <>
          <h1 class="post-title">{d.title}</h1>

          {d.media && (
            <p class="post-meta">{d.media}</p>
          )}
        </>
      ) : (
        <>
          <h1 class="post-title">{d.title}</h1>

          {d.date && (
            <p class="post-meta">
              {formatMonthYear(d.date, lang)}
            </p>
          )}
        </>
      )}
    </div>

    <div class="post-body">
      <Content />
    </div>
  </article>
</PostLayout>
)}
