---

<BaseLayout
  title={copy.home.metaTitle}
  description={copy.home.metaDescription}
  lang={lang}
  canonicalPath={canonicalHomePath("cs")}
  alternateCsPath={canonicalHomePath("cs")}
  alternateEnPath={canonicalHomePath("en")}
>
  <main class="home-page">
    <section class="home-section">
      <div class="section-header">
        <h2 class="page-title">
          <a href={section("volna-tvorba", lang)} class="section-link">
            {copy.home.sections["volna-tvorba"].title}
          </a>
        </h2>
        <p class="section-description">
          {copy.home.sections["volna-tvorba"].description}
        </p>
      </div>

      <PostTileGrid items={volnaTvorbaTiles} lang={lang} />
    </section>

    <section class="home-section">
      <div class="section-header">
        <h2 class="page-title">
          <a href={section("vystavy", lang)} class="section-link">
            {copy.home.sections.vystavy.title}
          </a>
        </h2>
        <p class="section-description">
          {copy.home.sections.vystavy.description}
        </p>
      </div>

      <PostTileGrid items={vystavyTiles} lang={lang} />
    </section>

    <section class="home-section">
      <div class="section-header">
        <h2 class="page-title">
          <a href={section("cestovani", lang)} class="section-link">
            {copy.home.sections.cestovani.title}
          </a>
        </h2>
        <p class="section-description">
          {copy.home.sections.cestovani.description}
        </p>
      </div>

      <PostTileGrid items={cestovaniTiles} lang={lang} />
    </section>

    <section class="home-section">
      <div class="section-header">
        <h2 class="page-title">
          <a
            href="https://www.youtube.com/playlist?list=PLQ5DFp2teh9ZCZmGgdapAWEz19cdN095t"
            class="section-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.home.sections.videos.title}
          </a>
        </h2>
        <p class="section-description">
          {copy.home.sections.videos.description}
        </p>
      </div>

      <PostTileGrid items={promoVideoTiles} lang={lang} />
    </section>

    <section class="home-section">
      <div class="section-header">
        <h2 class="page-title">{copy.home.about.title}</h2>
        <p class="section-description">
          {copy.home.about.description}
        </p>
      </div>

      <div class="home-about">
        <div class="embed embed--demo">
          <iframe
            class="embed__frame"
            src={headScanUrl}
            title={copy.home.about.embedTitle}
            allow="autoplay; fullscreen; xr-spatial-tracking"
            allowfullscreen
            mozallowfullscreen="true"
            webkitallowfullscreen="true"
          ></iframe>
        </div>

        <div class="post-body">
          {copy.home.about.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="section-header">
        <h2 class="page-title">{copy.home.contact.title}</h2>
        <p class="section-description">
          {copy.home.contact.description}
        </p>
      </div>

      <div class="home-contact">
        <div class="post-body">
          <p>
            <a href="tel:+420722264202">+420 722 264 202</a><br />
            <a href="mailto:vojta.maur@gmail.com">vojta.maur@gmail.com</a>
          </p>

          <div class="openpgp-contact">
            <p class="openpgp-intro">
              Pro šifrovanou komunikaci použijte můj veřejný OpenPGP klíč.
            </p>

            <p class="openpgp-fingerprint">
              fingerprint:<br />
              <code translate="no">
                57E9 D455 FB10 A228 F66E 18AE C5F5 B390 5220 BE59
              </code>
            </p>

            <p class="openpgp-key-label">Veřejný OpenPGP klíč:</p>
            <pre class="openpgp-key" translate="no"><code>{openPgpPublicKey}</code></pre>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .openpgp-contact {
    margin-top: 1.5rem;
  }

  .openpgp-contact code {
    overflow-wrap: anywhere;
  }

  .openpgp-intro {
    margin-bottom: 1rem;
  }

  .openpgp-fingerprint {
    margin-top: 0;
  }

  .openpgp-fingerprint code {
    display: block;
    margin-top: 0.25rem;
  }

  .openpgp-key-label {
    margin-bottom: 0.5rem;
  }

  .openpgp-key {
    max-width: 100%;
    margin-top: 0;
    overflow-x: auto;
    font-size: 0.75rem;
    white-space: pre;
  }
</style>
